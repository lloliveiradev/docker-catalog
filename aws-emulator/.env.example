EMULATOR_PORT=9297
# Ports for resources with their own endpoint, such as RDS instances. One port each.
EMULATOR_ENDPOINT_PORTS=9298-9317
EMULATOR_TELEMETRY=off
EMULATOR_MEMORY=2g
# Linux only: your "uid:gid", so the credential files belong to you.
# EMULATOR_USER=1000:1000
# Directory that holds .aws/emulator. Defaults to your home directory.
# EMULATOR_HOME=/absolute/path
